# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt


/.sourcemaps
/.versions
/coverage

# Ionic
/.ionic
/www
/platforms
/plugins
/ios
/android

# Generated
/src/environments/version.ts

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
/.model-cache
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.vscode
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace
.codex
.claude
.aws
.agents

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
*.iml


# Miscellaneous
/.angular
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
/.playwright

# System files
.DS_Store
Thumbs.db
